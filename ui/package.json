{
  "name": "fit-ai-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Fit AI HoloDrive: HUD interface for the Fit AI Core (React + TypeScript + Tailwind + Framer Motion)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "e2e:real": "node e2e/real.mjs"
  },
  "overrides": {
    "csstype": "3.1.3"
  },
  "dependencies": {
    "motion": "12.34.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "axe-core": "4.14.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.53.1",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
